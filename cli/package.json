{
  "name": "fe-rom-cli",
  "version": "0.1.0",
  "private": true,
  "description": "GBA Fire Emblem ROM parser CLI. Extracts unit, class and support data for AI analysis.",
  "bin": {
    "fe-rom": "./src/index.ts"
  },
  "type": "module",
  "scripts": {
    "info": "node src/index.ts info",
    "validate": "node src/index.ts validate",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-upstream.ts",
    "check:update": "node scripts/check-upstream.ts --update"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
