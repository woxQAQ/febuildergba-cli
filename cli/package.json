{
  "name": "fe-rom-cli",
  "version": "0.1.0",
  "private": true,
  "description": "GBA Fire Emblem ROM extractor. Parses a ROM once into a SQLite database for SQL analysis.",
  "bin": {
    "fe-rom": "./src/index.ts"
  },
  "type": "module",
  "scripts": {
    "extract": "node src/index.ts extract",
    "validate": "node src/index.ts validate",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-upstream.ts",
    "check:update": "node scripts/check-upstream.ts --update"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
